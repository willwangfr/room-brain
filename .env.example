# Copy to .env and fill in. Never commit .env.
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=web_unlocker1
COGNEE_API_URL=https://tenant-<your-tenant>.aws.cognee.ai
COGNEE_TENANT_ID=
COGNEE_API_KEY=
# Optional: OpenAI key for the local cognee graph (mapped to LLM_API_KEY by run.sh)
OPENAI_API_KEY=
